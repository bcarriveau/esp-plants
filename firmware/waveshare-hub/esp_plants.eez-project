      "colorBpp": "16",
      "bitmapColorFormat": "BGR",
      "description": "ESP PLANTS live Waveshare UI. EEZ Studio owns the Home, All Sensors, Plant Detail, Settings, and Advanced Zigbee static layouts. Runtime data, virtual lists, navigation behavior, dialogs, Zigbee, Wi-Fi, OTA, and persistence remain native firmware. LVGL 8.3, no EEZ Flow.",
      "resourceFiles": [],
      "hiddenWidgetLines": "dimmed",
      "dimmedLinesOpacity": "20",
      "embedBitmaps": true,
      "embedFonts": true,
      "cacheFonts": false
    },
    "build": {
      "objID": "d342587e-6528-48b4-934d-627eeef45a55",
      "configurations": [
        {
          "objID": "ec193e33-652a-4944-afdd-bf76b19d6f0d",
          "name": "Default"
        }
      ],
      "files": [
        {
          "objID": "9a079624-fb10-4f38-b0d6-16ca452d8275",
          "fileName": "screens.h",
          "template": "#ifndef ESP_PLANTS_EEZ_SCREENS_H\n#define ESP_PLANTS_EEZ_SCREENS_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_SCREENS_DECL}\n//${eez-studio LVGL_SCREENS_DECL_EXT}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
        },
        {
          "objID": "a17b58bc-7c24-4403-8a38-3bd8638ecf7a",
          "fileName": "screens.c",
          "template": "#include \"screens.h\"\n#include \"fonts.h\"\n\n//${eez-studio LVGL_SCREENS_DEF}\n//${eez-studio LVGL_SCREENS_DEF_EXT}\n"
        },
        {
          "objID": "7073dfd4-a295-489d-ac7a-21735d15273d",
          "fileName": "fonts.h",
          "template": "#ifndef ESP_PLANTS_EEZ_FONTS_H\n#define ESP_PLANTS_EEZ_FONTS_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_FONTS_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
        },
        {
          "objID": "1cf168b5-4877-468e-bf8e-ab4d483d143c",
          "fileName": "ui.h",
          "template": "#ifndef ESP_PLANTS_EEZ_UI_H\n#define ESP_PLANTS_EEZ_UI_H\n\n//${eez-studio LVGL_INCLUDE}\n#include \"screens.h\"\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\nvoid ui_init(void);\nvoid ui_tick(void);\nvoid loadScreen(enum ScreensEnum screenId);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
        },
        {
          "objID": "bfd27e2d-fc71-4510-8982-f34a89ba31bc",
          "fileName": "ui.c",
          "template": "#include \"ui.h\"\n\nstatic int16_t currentScreen = -1;\n\nstatic lv_obj_t *getLvglObjectFromIndex(int32_t index) {\n    if (index < 0) {\n        return 0;\n    }\n    return ((lv_obj_t **)&objects)[index];\n}\n\nvoid loadScreen(enum ScreensEnum screenId) {\n    currentScreen = (int16_t)screenId - 1;\n    lv_obj_t *screen = getLvglObjectFromIndex(currentScreen);\n    if (screen) {\n        lv_scr_load(screen);\n    }\n}\n\nvoid ui_init(void) {\n    create_screens();\n    loadScreen(SCREEN_ID_HOME);\n}\n\nvoid ui_tick(void) {\n    if (currentScreen >= 0) {\n        tick_screen(currentScreen);\n    }\n}\n"
        }
      ],
      "destinationFolder": "src\\ui",
      "separateFolderForImagesAndFonts": false,
      "imageExportMode": "source",
      "fontExportMode": "source",
      "fileSystemPath": "",
      "lvglInclude": "lvgl.h",
      "screensLifetimeSupport": false,
      "useDockerDesktop": true,
      "generateSourceCodeForEezFramework": false,
      "compressFlowDefinition": false,
      "executionQueueSize": 1000,
      "expressionEvaluatorStackSize": 20
    }
  },
