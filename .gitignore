# PlatformIO build/package state
**/.pio/
**/.pio-packages/

# VS Code / PlatformIO local workspace state
# Keep the shared root tasks; ignore machine-specific editor state.
**/.vscode/*
!.vscode/tasks.json
*.code-workspace

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python/tooling
__pycache__/
*.pyc
.venv/
venv/

# Local notes / secrets / exports
.env
.env.*
secrets.*
*.local
*.bak
*.tmp

# Serial/build logs
*.log
logs/

# Local ESP PLANTS patch/apply helpers
/*.cmd
/*.ps1
/*.patch
/*.diff

# Temporary patch-package notes/exports
/README-FIRST*.txt
/COMMIT MESSAGE*.txt
/ESP_PLANTS_*.zip
crashdumps/
