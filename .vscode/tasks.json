      "command": "pio",
      "windows": {
        "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe"
      },
      "args": [
        "run",
        "-d",
        "${workspaceFolder}\\firmware\\waveshare-hub"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
