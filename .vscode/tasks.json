{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP PLANTS: Test shared protocol",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "${workspaceFolder}\\tools\\test_shared.cmd"
      ],
      "problemMatcher": []
    },
